<?xml version="1.0" encoding="utf-8"?>
<!-- Cho phép luồng HTTP không mã hoá (nhiều máy chủ phát chỉ có http://) trên mọi phiên bản Android. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
